{
  "meta": {
    "name": "Harvey",
    "direction": "Bordeaux & Pierre",
    "version": "1.0.0",
    "source": "Harvey.figcraft, page « Brand guide », variable collections « Harvey · Couleurs » (modes Clair / Sombre) and « Harvey · Dimensions ». Keep both in sync: change the variables in figcraft, then this file, then run `bun brand/build-tokens.ts`."
  },
  "color": {
    "surface": {
      "fond": { "light": "#F5F2EC", "dark": "#1A1614", "description": "Window background" },
      "surface": { "light": "#FFFFFF", "dark": "#231E1B", "description": "Cards, main content" },
      "barre-laterale": { "light": "#EBE6DD", "dark": "#1A1614", "description": "Sidebar, recessed areas" },
      "bordure": { "light": "#D8D1C4", "dark": "#362F2B", "description": "Card and field borders" },
      "separateur": { "light": "#EBE6DD", "dark": "#2D2724", "description": "Dividers, neutral pills, disabled fills" }
    },
    "texte": {
      "principal": { "light": "#221D1A", "dark": "#EEE8E1", "description": "Headings and body text (14.9:1 / 14.8:1)" },
      "secondaire": { "light": "#645B53", "dark": "#ABA197", "description": "Metadata, captions, labels (5.9:1 / 7.1:1)" }
    },
    "marque": {
      "primaire": { "light": "#7A1F2B", "dark": "#E39AA3", "description": "Primary action, running timer, selection (9.1:1 / 8.1:1)" },
      "sur-primaire": { "light": "#FFFFFF", "dark": "#2A0C11", "description": "Text and icons on primaire" },
      "primaire-teinte": { "light": "#EBD5D8", "dark": "#3D2126", "description": "Selected sidebar item, hover" },
      "primaire-teinte-texte": { "light": "#5E1520", "dark": "#F2C4C9", "description": "Text on primaire-teinte" },
      "accent": { "light": "#4F6B55", "dark": "#9DB8A2", "description": "Pins, focus ring, secondary emphasis (5.3:1 / 8.4:1)" },
      "accent-teinte": { "light": "#E3EBE4", "dark": "#25302A", "description": "Background behind accent text" }
    },
    "statut": {
      "succes": { "light": "#2E7550", "dark": "#74C493", "description": "Paid, signed, backup OK" },
      "succes-fond": { "light": "#E4EFE8", "dark": "#1D2C23" },
      "attention": { "light": "#8F5E00", "dark": "#E4AE4C", "description": "To chase up, deadline soon, sync pending" },
      "attention-fond": { "light": "#F3EAD8", "dark": "#30261A" },
      "erreur": { "light": "#AA3C0D", "dark": "#F59563", "description": "Overdue, conflict, failure. Burnt orange so it never reads as the bordeaux primary; always paired with a word or icon" },
      "erreur-fond": { "light": "#F6E4DA", "dark": "#35221A" },
      "info": { "light": "#2D5F8B", "dark": "#8DB6DE", "description": "In progress, neutral information" },
      "info-fond": { "light": "#E2EBF3", "dark": "#1C2733" }
    }
  },
  "palette": {
    "neutre": {
      "50": "#F5F2EC",
      "100": "#EBE6DD",
      "200": "#D8D1C4",
      "300": "#BFB7AA",
      "400": "#9E968B",
      "500": "#7F776E",
      "600": "#645B53",
      "700": "#443D38",
      "900": "#221D1A"
    },
    "liste": {
      "$description": "User-pickable colours for reference-list values (statuses, practice areas — FR-11). fg on bg passes 4.5:1 in both themes.",
      "bordeaux": { "light": { "fg": "#9E2E3D", "bg": "#F6DFE2" }, "dark": { "fg": "#D77582", "bg": "#372023" } },
      "rouille": { "light": { "fg": "#9A4E2D", "bg": "#F6E6DF" }, "dark": { "fg": "#D38969", "bg": "#372720" } },
      "ocre": { "light": { "fg": "#826026", "bg": "#F6EEDF" }, "dark": { "fg": "#D3AC69", "bg": "#372E20" } },
      "olive": { "light": { "fg": "#696B2E", "bg": "#F2F3E2" }, "dark": { "fg": "#C2C577", "bg": "#333324" } },
      "sauge": { "light": { "fg": "#317241", "bg": "#E2F3E7" }, "dark": { "fg": "#77C58B", "bg": "#243327" } },
      "pin": { "light": { "fg": "#217368", "bg": "#DFF6F3" }, "dark": { "fg": "#69D3C5", "bg": "#203734" } },
      "ardoise": { "light": { "fg": "#3C6A8B", "bg": "#E2ECF3" }, "dark": { "fg": "#77A5C5", "bg": "#242D33" } },
      "indigo": { "light": { "fg": "#2E3D9E", "bg": "#DFE2F6" }, "dark": { "fg": "#818CDA", "bg": "#202337" } },
      "prune": { "light": { "fg": "#9E2E9E", "bg": "#F6DFF6" }, "dark": { "fg": "#D56DD5", "bg": "#372037" } },
      "taupe": { "light": { "fg": "#7C5F46", "bg": "#EFEAE7" }, "dark": { "fg": "#B99C83", "bg": "#302B27" } }
    }
  },
  "font": {
    "ui": { "family": "Inter", "fallback": ["-apple-system", "BlinkMacSystemFont", "system-ui", "sans-serif"], "weights": [400, 500, 600], "license": "SIL OFL 1.1" },
    "lecture": { "family": "Newsreader", "fallback": ["Georgia", "serif"], "weights": [400, 500], "italic": true, "license": "SIL OFL 1.1" },
    "mono": { "family": "JetBrains Mono", "fallback": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "weights": [400, 500], "license": "SIL OFL 1.1" }
  },
  "text": {
    "titre-page": { "font": "ui", "size": 28, "lineHeight": 34, "weight": 600, "letterSpacing": "-0.01em" },
    "titre-section": { "font": "ui", "size": 20, "lineHeight": 26, "weight": 600 },
    "titre-carte": { "font": "ui", "size": 15, "lineHeight": 20, "weight": 600 },
    "corps": { "font": "ui", "size": 13, "lineHeight": 18, "weight": 400 },
    "corps-fort": { "font": "ui", "size": 13, "lineHeight": 18, "weight": 500 },
    "legende": { "font": "ui", "size": 11, "lineHeight": 14, "weight": 600, "letterSpacing": "0.06em", "transform": "uppercase" },
    "note-titre": { "font": "lecture", "size": 26, "lineHeight": 32, "weight": 500 },
    "note-corps": { "font": "lecture", "size": 18, "lineHeight": 27, "weight": 400, "maxWidth": 680 },
    "mono": { "font": "mono", "size": 13, "lineHeight": 18, "weight": 400 },
    "mono-petit": { "font": "mono", "size": 11, "lineHeight": 14, "weight": 400 }
  },
  "radius": { "petit": 6, "moyen": 10, "grand": 16 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32 },
  "shadow": { "flottant": "0 6px 16px rgba(0, 0, 0, 0.18)" },
  "motion": { "duration": 150, "easing": "ease-out" },
  "shadcn": {
    "$description": "shadcn/ui CSS variable → Harvey colour token (group.name).",
    "background": "surface.fond",
    "foreground": "texte.principal",
    "card": "surface.surface",
    "card-foreground": "texte.principal",
    "popover": "surface.surface",
    "popover-foreground": "texte.principal",
    "primary": "marque.primaire",
    "primary-foreground": "marque.sur-primaire",
    "secondary": "surface.barre-laterale",
    "secondary-foreground": "texte.principal",
    "muted": "surface.barre-laterale",
    "muted-foreground": "texte.secondaire",
    "accent": "marque.primaire-teinte",
    "accent-foreground": "marque.primaire-teinte-texte",
    "destructive": "statut.erreur",
    "border": "surface.bordure",
    "input": "surface.bordure",
    "ring": "marque.accent",
    "sidebar": "surface.barre-laterale",
    "sidebar-foreground": "texte.principal",
    "sidebar-accent": "marque.primaire-teinte",
    "sidebar-accent-foreground": "marque.primaire-teinte-texte",
    "sidebar-border": "surface.bordure",
    "sidebar-ring": "marque.accent"
  }
}
